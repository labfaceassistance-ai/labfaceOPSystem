# ============================================================
# LabFace — copy this file to .env.prod and fill in real values
# Never commit .env.prod or any file with real credentials
# ============================================================

# Database
DB_ROOT_PASSWORD=changeme_root
DB_PASSWORD=changeme_user
DB_NAME=labface
DB_USER=labface_user
DB_HOST=mariadb
DB_PORT=3306

# MinIO Object Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_ENDPOINT=minio
MINIO_PORT=9000

# Cloudflare Tunnel (production only)
TUNNEL_TOKEN=

# Application
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=http://backend:5000
AI_SERVICE_URL=http://ai-service:8000

# CCTV Cameras — store real credentials ONLY in .env.prod (never in code)
RTSP_URL_1=rtsp://user:pass@camera-ip:554/cam/realmonitor?channel=1&subtype=0
RTSP_URL_2=rtsp://user:pass@camera-ip:554/cam/realmonitor?channel=2&subtype=0

# AI Service
FACE_RECOGNITION_THRESHOLD=0.55
TEST_MODE=false
