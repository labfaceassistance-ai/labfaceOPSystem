# Backend production configuration
PORT=5000
NODE_ENV=production

# Database
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=labface

# AI service
AI_SERVICE_URL=https://ai.your-domain.com

# Object storage (replace MinIO with your hosted S3-compatible provider)
MINIO_ENDPOINT=your-storage-endpoint
MINIO_PORT=443
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_USE_SSL=true

# Frontend
FRONTEND_URL=https://labface.site

# Versioning
BUILD_ID=prod
